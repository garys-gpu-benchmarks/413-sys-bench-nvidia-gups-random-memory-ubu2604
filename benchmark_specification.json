  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Measure random 64-bit memory update performance"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates GUPS throughput and TLB/L3 miss rates from the C++ random-update benchmark"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: Giga-updates score (giga_updates_score); #2: Random 64-bit update rate (updates_sec); #3: 8-byte payload update rate, GB/s (payload_update_gb_s)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile gups.c; run bin/gups; optionally wrap with perf stat -e dTLB-load-misses,cache-misses,instructions"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/gups.c and run bin/gups with yaml table_size, num_updates, and seed, optionally wrapping with perf stat -e dTLB-load-misses,cache-misses,instructions, then derive GB/s as 8-byte updates/s, to measure random 64-bit update rate. Profile caps iterations at 2 / 8 / 24 regardless of a larger yaml request"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compile src/gups.c, run bin/gups with yaml table_size, num_updates, and seed, and optionally wrap it with perf stat for dTLB-load-misses, cache-misses, and instructions. Derive GB/s as 8-byte updates per second. The profile caps iterations at 2, 8, or 24"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Builds src/gups.c (OpenMP C, not C++) into bin/gups and issues random 64-bit table updates. table_size: table bytes. num_updates: updates per iteration. num_iterations: requested loops, capped to 2/8/24 for smoke/baseline/extended. num_threads, seed, and numa_node come from yaml. Optional perf stat records dTLB-load-misses, cache-misses, and instructions. thread_affinity and page_size yaml fields are not applied as huge-page setup"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CPU / System"
  },
